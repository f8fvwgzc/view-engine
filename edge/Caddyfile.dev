# HTTP/3 edge for local development (`make dev`): the API and the Vite dev server run on the host, Caddy runs in
# Docker in front of both at https://localhost:8443. Vite's HMR WebSocket goes through the same origin.

{
	https_port {$EDGE_PORT:8443}
	http_port {$EDGE_HTTP_PORT:8080}
	auto_https disable_redirects
	servers {
		protocols h1 h2 h3
	}
}

import api.caddy

{$SITE_ADDRESS:localhost} {
	encode zstd gzip
	import hardening
	import api

	handle {
		reverse_proxy {$UI_UPSTREAM:host.docker.internal:5173}
	}
}
