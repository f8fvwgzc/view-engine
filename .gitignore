# build output
backend/target
frontend/node_modules
frontend/dist

# generated by `tsc -b` (sources are the .ts files)
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# secrets and local environment — never commit
.env
.env.*
!.env.example
*.pem
*.key
token

# logs and OS files
*.log
.DS_Store

# quant sidecar
quant/.venv
quant/.cache
__pycache__/
.pytest_cache/

# RLCD: trained models, registry and feedback are local artifacts
backend/rlcd/.venv
backend/rlcd/var/

# user skill library: local data, not shipped with the engine
skills/*
!skills/README.md
quant/data/
